[Unit]
Description=240-MP Media Player
# On screen as early as the display allows: after basic.target (the default
# dependencies) and the sound card, not after multi-user.target like the
# unit scripts/install.sh writes. The services listed in /etc/240mp/boot-units
# hold back until the app has drawn its first frame and written
# MP240_READY_FILE (see /usr/lib/240mp/wait-for-app); the boot screen shows
# them coming up.
After=sound.target
# Pulls in the connection check the boot screen ends on, without waiting for it.
Wants=network-online.target

[Service]
Type=simple
User=@FIRST_USER_NAME@
SupplementaryGroups=tty video input
AmbientCapabilities=CAP_SYS_TTY_CONFIG
Environment=QT_QPA_PLATFORM=eglfs
Environment=QT_QPA_EGLFS_ALWAYS_SET_MODE=1
Environment=QT_QPA_EGLFS_KMS_ATOMIC=1
Environment=QML2_IMPORT_PATH=/usr/lib/aarch64-linux-gnu/qt6/qml
Environment=MP240_AUTOSTART=1
Environment=MP240_BOOT_UNITS_FILE=/etc/240mp/boot-units
Environment=MP240_READY_FILE=/run/240mp/ready
RuntimeDirectory=240mp
ExecStartPre=+-/usr/bin/systemctl stop 240mp-terminal.service
ExecStartPre=-/usr/lib/240mp/wait-for-display
ExecStart=/usr/local/bin/240mp
Restart=on-failure
RestartSec=5s
RestartPreventExitStatus=10 12
ExecStopPost=+/usr/local/bin/240mp-stop
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
