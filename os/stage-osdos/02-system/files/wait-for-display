#!/bin/sh
# ExecStartPre= of osdos.service. The app starts this early in the boot, the
# vc4 KMS driver may not have registered a display connector yet; Qt EGLFS
# would then fail, and after three such starts the service would give up on
# the app for a login prompt. Waits up to five seconds for one, and never fails.

i=0
while [ "$i" -lt 100 ]; do
    for status in /sys/class/drm/card*-*/status; do
        [ -e "$status" ] && exit 0
    done
    sleep 0.05
    i=$((i + 1))
done
exit 0
