#!/bin/sh

# OSD/OS image: in place of raspberrypi-sys-mods' resize_early, which a script of
# the same name here in /etc/initramfs-tools/scripts overrides.
#
# On the first boot (" resize" on the kernel command line, which
# set_partuuid takes off afterwards) Raspberry Pi OS grows the root partition
# to the end of the card. This grows it to ROOT_MIB instead and gives the rest
# of the card to a partition of its own, with an exFAT filesystem labelled
# OSD-OS. Windows and macOS open that too, so films copied onto it from a
# computer show up in Local Files (it is mounted at /media/OSD-OS). With too
# little left over for films, or ROOT_MIB 0, the root partition takes the
# whole card, as stock. rpi-resize.service grows the root filesystem to its
# partition either way.
#
# Nothing here may stop the boot: what fails is logged, and the card is left
# as far as it got.

case "$1" in
  prereqs)
    exit 0
    ;;
esac

if ! grep -q ' resize' /proc/cmdline; then
  exit 0
fi

ROOT_MIB=@ROOT_MIB@      # the root partition (os/build.sh's OSDOS_ROOT_SIZE)
MEDIA_MIN_MIB=2048       # less than this left for films: no film partition
ALIGN=8192               # partitions start on 4 MiB, in 512-byte sectors

get_variables () {
  local_device_setup "$ROOT" "root file system"
  ROOT_PART_NAME="$(lsblk -no kname "$DEV")"

  ROOT_DEV_NAME="$(lsblk -no pkname "$DEV")"
  ROOT_DEV="/dev/$ROOT_DEV_NAME"

  ROOT_PART_NUM=$(cat "/sys/block/$ROOT_DEV_NAME/$ROOT_PART_NAME/partition")
  ROOT_PART_START=$(cat "/sys/block/$ROOT_DEV_NAME/$ROOT_PART_NAME/start")
  ROOT_PART_SIZE=$(cat "/sys/block/$ROOT_DEV_NAME/$ROOT_PART_NAME/size")

  ROOT_DEV_SIZE=$(cat "/sys/block/$ROOT_DEV_NAME/size")
  TARGET_END="$((ROOT_DEV_SIZE - 1))"
  if [ "$TARGET_END" -gt 4294967295 ]; then
    TARGET_END=4294967295
  fi

  # The film partition: mmcblk0p3, or sda3 on a disk.
  case "$ROOT_DEV_NAME" in
    *[0-9]) MEDIA_NAME="${ROOT_DEV_NAME}p3" ;;
    *) MEDIA_NAME="${ROOT_DEV_NAME}3" ;;
  esac
}

grow_root () {
  if ! parted -s -m "$ROOT_DEV" u s resizepart "$ROOT_PART_NUM" "$1"; then
    log_warning_msg "Could not grow the root partition"
  fi
}

make_media () {
  # "ntfs" makes it MBR type 0x07, where Windows looks for exFAT.
  if ! parted -s -m "$ROOT_DEV" u s mkpart primary ntfs "$1" "$TARGET_END"; then
    log_warning_msg "Could not make the film partition"
    return
  fi
  # udev makes its device node in a moment.
  udevadm settle --timeout=10 2> /dev/null
  WAITED=0
  while [ ! -b "/dev/$MEDIA_NAME" ] && [ "$WAITED" -lt 10 ]; do
    sleep 1
    WAITED=$((WAITED + 1))
  done
  if ! mkfs.exfat -L OSD-OS "/dev/$MEDIA_NAME"; then
    log_warning_msg "Could not format the film partition"
  fi
}

. /scripts/functions
. /scripts/local

log_begin_msg "Resizing root partition..."

get_variables
if [ "$ROOT_PART_NUM" != 2 ]; then
  log_warning_msg "Resize skipped due to unexpected partition table"
elif [ -e "/sys/block/$ROOT_DEV_NAME/$MEDIA_NAME" ]; then
  # A first boot cut short after this ran: the partitions are made already.
  log_warning_msg "Resize skipped: the card has its film partition already"
else
  ROOT_END=$((ROOT_PART_START + ROOT_MIB * 2048 - 1))
  CUR_END=$((ROOT_PART_START + ROOT_PART_SIZE - 1))
  if [ "$ROOT_END" -lt "$CUR_END" ]; then
    ROOT_END=$CUR_END
  fi
  MEDIA_START=$(( (ROOT_END + ALIGN) / ALIGN * ALIGN ))
  if [ "$ROOT_MIB" -gt 0 ] && [ $((TARGET_END + 1 - MEDIA_START)) -ge $((MEDIA_MIN_MIB * 2048)) ]; then
    if [ "$ROOT_END" -gt "$CUR_END" ]; then
      grow_root "$ROOT_END"
    fi
    make_media "$MEDIA_START"
  else
    grow_root "$TARGET_END"
  fi
fi

log_end_msg

exit 0
